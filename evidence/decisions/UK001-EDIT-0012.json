  "human_auditable_considerations": {
    "question": "Whether the inherited four-column display was a defensible simplification or a source-layout defect that obscured the schema's continuation relation.",
    "evidence_weighed": [
      "Project authority ED0014 lines 606-658 contain five columns, the terminal upper row, and two linked source-rosette positions.",
      "The retained printed/GDZ witnesses and exact-5000 authority evidence independently show the same glyph and attachment logic.",
      "The inherited Ukrainian note already explains the lower attachment correctly and requires no lexical editing."
    ],
    "alternatives_rejected": [
      "Retain four columns, because that preserves a material omission rather than a coherent source variant.",
      "Substitute a generic star, because the source uses two matching non-generic rosette marks.",
      "Redraw or smooth the glyph, because the accepted source-derived bitmap already has exact custody and placement receipts.",
      "Reword the Ukrainian note, because its content is adequate and byte-exact preservation avoids unnecessary translation drift.",
      "Mutate frozen v047, public r35, or standalone DOI artifacts, because this repair belongs only to the isolated successor."
    ],
    "claim_boundary": "Project-authority source-layout fidelity and visual legibility; not native-Ukrainian validation, community certification, or a new critical German edition."
  },
